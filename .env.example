# Server
PORT=8080
# Comma-separated browser origins. Keep production deployments explicit.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Postgres (Supabase connection string, use the "Session pooler" or direct
# connection string from Project Settings -> Database)
DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Path to the SQL migration files, relative to the working directory the
# binary is run from
MIGRATIONS_PATH=migrations

# Central SSO service (sso-balai)
SSO_BASE_URL=http://127.0.0.1:18082
SSO_CLIENT_ID=silapet-web
SSO_REDIRECT_URI=http://localhost:8081/auth/sso/callback
SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:8081/login
# Base64-encoded random key of at least 32 bytes. Never commit a real value.
SSO_FLOW_HMAC_KEY=
SSO_FLOW_TTL=5m
# Must match Central's SSO_SILAPET_INTROSPECTION_SECRET; minimum 32 characters.
SSO_INTROSPECTION_SECRET=

# Encrypted HttpOnly SILAPET application session.
# Required: base64-encoded random 32-byte key. Never commit a real value.
APP_SESSION_KEY=
APP_SESSION_TTL=168h
APP_SESSION_COOKIE_SECURE=false

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# Service role key: required for server-side Supabase Storage operations
# (resource photo uploads, booking proof uploads, and signed proof URLs)
# and optional first-boot admin seeding. Keep this secret; never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Project Settings -> API -> JWT Settings -> JWT Secret (legacy HS256 secret)
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# Supabase Storage buckets
SUPABASE_STORAGE_BUCKET_RESOURCES=resource-photos
SUPABASE_STORAGE_BUCKET_PROOFS=booking-proofs

# Initial admin account, created automatically on first boot if the
# app_users table is empty (requires SUPABASE_SERVICE_ROLE_KEY above)
SEED_ADMIN_EMAIL=admin@office-craft.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FULL_NAME=System Administrator

OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-STRING
OPENWA_SESSION_ID=<the sessionId from step 5>

#email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=test@example.com
SMTP_PASSWORD=app-password-generated-from-google-account
SMTP_FROM_NAME="SILAPET - Sistem Informasi Laporan Pemakaian Aset"
SMTP_FROM_EMAIL=test@example.com
